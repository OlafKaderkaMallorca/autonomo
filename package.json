{
  "name": "autonomo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "einrichten": "node scripts/einrichten.mjs",
    "db:start": "docker compose -f dev/docker-compose.yml up -d",
    "db:stop": "docker compose -f dev/docker-compose.yml down",
    "dev": "pnpm --filter @autonomo/shared build && pnpm --parallel --filter @autonomo/api --filter @autonomo/web dev",
    "dev:mobile": "pnpm --filter @autonomo/mobile start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22"
  }
}
