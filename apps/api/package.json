{
  "name": "@autonomo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx --env-file=.env src/migrate.ts",
    "admin:anlegen": "node dist/cli/admin-anlegen.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx --env-file=.env src/cli/demo-daten.ts"
  },
  "dependencies": {
    "@autonomo/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.3.0",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
