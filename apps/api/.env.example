# Lokale Entwicklung: nach apps/api/.env kopieren (pnpm run einrichten macht das automatisch).
PORT=4002
DATABASE_URL=postgres://autonomo_app:app@localhost:5434/autonomo
MIGRATION_DATABASE_URL=postgres://autonomo_owner:owner@localhost:5434/autonomo
WEB_URL=http://localhost:3012
# Lokal: Test-Postfach Mailpit (http://localhost:8026). Leer lassen = Mails nur im Terminal der API.
SMTP_URL=smtp://localhost:1026
MAIL_ABSENDER=ApuntaPro <no-reply@apuntapro.local>
# Fotos, PDFs und Logos (relativ zu apps/api)
DATEI_ORDNER=daten
# Optional: Pfad zu Chrome/Edge für PDFs. Leer = automatisch (Windows: Microsoft Edge)
PDF_BROWSER=
