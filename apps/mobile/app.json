{
  "expo": {
    "name": "ApuntaPro",
    "slug": "apuntapro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.apuntapro.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "ApuntaPro nutzt Face ID, um die App zu entsperren."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2937",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "es.apuntapro.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "apuntapro",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ApuntaPro nutzt Face ID, um die App zu entsperren."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ApuntaPro braucht Zugriff auf deine Fotos, um Arbeitsfotos zu Aufgaben hinzuzufügen.",
          "cameraPermission": "ApuntaPro braucht die Kamera für Arbeitsfotos zu Aufgaben.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4002"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2937"
    }
  }
}
